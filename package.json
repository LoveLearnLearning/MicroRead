{
  "name": "micro-read",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @reader/web dev",
    "dev:web": "pnpm --filter @reader/web dev",
    "start:web": "pnpm --filter @reader/web start",
    "dev:desktop": "pnpm --filter @reader/desktop tauri:dev",
    "build:desktop": "pnpm --filter @reader/desktop tauri:build",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
