# Optional AI support for the local Web runtime.
# Keep the real value in the process environment or an ignored .env.local file.
# Reading, search, annotations and backups work without this key.
OPENAI_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
AI_REQUESTS_PER_HOUR=30
